# Build output: regenerated by generator/build.py and tools/ship.py
/out/
/mod/

# Third-party reference renders (not ours to publish) and the archived layout traced from them.
# Only generator/ref_trace.py, camfit.py and preview.py read ref/; the vehicle build does not.
/ref/
/archive/

# Test-instance runtime state (testenv/game.py, hard_scenarios.py)
/testenv/STORM_PLAYING.flag
/testenv/game.pid
/testenv/game.pid.starting
/testenv/test_copy.lock
/testenv/probe_id.txt
/testenv/wheelcheck_id.txt
/testenv/ride_log.txt

# Training: large data dumps, raw stdout logs, file backups
/training/*.npy
/training/*.log
*.bak

# Python, editors, OS
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini
